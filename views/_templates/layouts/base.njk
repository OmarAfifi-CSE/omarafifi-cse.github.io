<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if seo_title %}{{ seo_title }}{% elif title and title != 'Omar Afifi' %}{{ title }} — Omar Afifi{% else %}Omar Afifi - Software Engineer{% endif %}</title>
  <meta name="description" content="{{ description | default('Omar Afifi — Software Engineer & Flutter Developer crafting premium digital experiences.') }}">

  <!-- Open Graph / SEO -->
  <meta name="theme-color" content="#fcfaf8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)">
  <meta name="keywords" content="Omar Afifi, Software Engineer, Flutter Developer, IoT, Mobile Development, Zagazig University, Software Engineering">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="{% if seo_title %}{{ seo_title }}{% elif title and title != 'Omar Afifi' %}{{ title }} — Omar Afifi{% else %}Omar Afifi - Software Engineer{% endif %}">
  <meta property="og:description" content="{{ description | default('Omar Afifi — Software Engineer & Flutter Developer crafting premium digital experiences.') }}">
  <meta property="og:image" content="https://omar-afifi.com/images/Omar.webp">
  <meta property="og:image:alt" content="Omar Afifi - Software Engineer">
  <meta property="og:url" content="https://omar-afifi.com{{ page.url }}">
  <meta property="og:site_name" content="Omar Afifi">
  <meta property="og:type" content="website">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if seo_title %}{{ seo_title }}{% elif title and title != 'Omar Afifi' %}{{ title }} — Omar Afifi{% else %}Omar Afifi - Software Engineer{% endif %}">
  <meta name="twitter:description" content="{{ description | default('Omar Afifi — Software Engineer & Flutter Developer crafting premium digital experiences.') }}">
  <meta name="twitter:image" content="https://omar-afifi.com/images/Omar.webp">
  
  <link rel="canonical" href="https://omar-afifi.com{{ page.url }}" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Omar Afifi",
    "url": "https://omar-afifi.com/",
    "sameAs": [
      "https://www.linkedin.com/in/omar-a-afifi",
      "https://github.com/omarafifi-cse",
      "https://www.facebook.com/omar.a.afifi.cs/",
      "https://www.instagram.com/omar.a.afifi/"
    ],
    "jobTitle": "Software Engineer",
    "worksFor": {
      "@type": "Organization",
      "name": "Freelancer"
    },
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Zagazig University",
      "sameAs": "https://www.zu.edu.eg/"
    },
    "image": "https://omar-afifi.com/images/Omar.webp"
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles/main.css">
  {% block styles %}{% endblock %}

  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon_io/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon_io/favicon-16x16.png">
  <link rel="manifest" href="/images/favicon_io/site.webmanifest">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  {% include "partials/header.njk" %}

  <main id="main-content">
    {% block content %}{% endblock %}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/js/main.js" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>
